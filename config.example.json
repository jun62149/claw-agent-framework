{
  "_comment": "把本文件复制为 config.json 后填入真实值。config.json 已在 .gitignore 中，不会被提交。也推荐改用环境变量（见下方说明），环境变量优先级高于本文件。",
  "_env_override": {
    "api_key": "NANOCLAW_API_KEY",
    "qq_app_id": "QQ_APP_ID",
    "qq_app_secret": "QQ_APP_SECRET",
    "feishu_app_id": "FEISHU_APP_ID",
    "feishu_app_secret": "FEISHU_APP_SECRET"
  },

  "api_key": "sk-REPLACE_WITH_YOUR_DEEPSEEK_KEY",
  "base_url": "https://api.deepseek.com",
  "model": "deepseek-chat",

  "max_iterations": 32,
  "workspace": "output",
  "identity_file": "identity.md",

  "token_budget": 6000,
  "consolidation_threshold": 8000,
  "max_tokens": 4000,

  "qq_app_id": "",
  "qq_app_secret": "",
  "feishu_app_id": "",
  "feishu_app_secret": "",

  "mcp_servers": {
    "memo": {
      "command": "python",
      "args": ["mcp_servers/memo_server.py"]
    },
    "poetry": {
      "command": "python",
      "args": ["mcp_servers/poetry_server.py"]
    }
  }
}
